#!/usr/bin/env python3
"""
runner - Development wrapper for the pwr-tray app
Located in the top-level app directory.
Allows running the app from source for debugging with support for command-line arguments.

Usage:
    ./runner {options-and-args}
    ./runner --help     (show all available options)

The app is executed as ``python -m pwr_tray.main`` rather than through runpy so
that its command line looks exactly like a restarted instance; PyKill matches
on that command line when it takes over from one.

``./runner`` is a developer's "run this source tree now", so it passes
``--replace``: the applet takes the single-instance lock first and, if another
instance still holds it, terminates that instance and takes over.  Pass
``--replace`` yourself and it is not added twice.
"""

import os
import sys

if __name__ == '__main__':
    project_root = os.path.dirname(os.path.abspath(__file__))
    env = dict(os.environ)
    # Keep the sources importable even when ./runner is called from elsewhere.
    env['PYTHONPATH'] = os.pathsep.join(
        [project_root] + ([env['PYTHONPATH']] if env.get('PYTHONPATH') else []))
    args = [sys.executable, '-m', 'pwr_tray.main']
    if '--replace' not in sys.argv[1:]:
        # Running ./runner means "start my source tree now", so hand over from
        # a running instance instead of refusing to start (which is what a
        # plain `pwr-tray` launch does when the lock is held).
        args.append('--replace')
    # execv keeps this pid but replaces the command line, so 'ps' (and PyKill)
    # see 'python -m pwr_tray.main' instead of 'python runner'.
    os.execve(sys.executable, args + sys.argv[1:], env)
