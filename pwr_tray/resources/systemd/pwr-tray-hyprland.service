# pwr-tray as a systemd --user service -- Hyprland (Wayland) example
#
# Structurally validated in CI; still review before use.
# Install (copy as ~/.config/systemd/user/pwr-tray.service):
#   mkdir -p ~/.config/pwr-tray ~/.config/systemd/user
#   cp pwr-tray-hyprland.service ~/.config/systemd/user/pwr-tray.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now pwr-tray.service
#
# NOTE: Hyprland also exposes HYPRLAND_INSTANCE_SIGNATURE. If pwr-tray's
# hyprctl calls fail under the service, import it into the session env, e.g.
# set it from `hyprctl instances` or add an Environment= line with your value.

[Unit]
Description=pwr-tray (power/energy tray applet)
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland
PartOf=graphical-session.target
After=graphical-session.target
BindsTo=graphical-session.target
# Give up on a genuine crash loop instead of respawning forever.
StartLimitIntervalSec=60
StartLimitBurst=5
Requires=dbus.socket
After=dbus.socket

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
Environment=XDG_CURRENT_DESKTOP=Hyprland
Environment=XDG_SESSION_TYPE=wayland
Environment=WAYLAND_DISPLAY=wayland-1
ExecStartPre=/bin/sleep 1
ExecStart=%h/.local/bin/pwr-tray --de hyprland-wayland
Restart=always
RestartSec=5
# Exit codes 2 and 3 are permanent: 3 means another pwr-tray holds the lock,
# 2 means the applet could not be constructed (unknown desktop, missing
# resource, or a required command missing from PATH).  Restarting those only
# repeats the same failure every 5 seconds, so let the unit fail instead.
RestartPreventExitStatus=2 3
StandardOutput=append:%h/.config/pwr-tray/debug.log
StandardError=inherit

[Install]
WantedBy=graphical-session.target
