# pwr-tray as a systemd --user service -- MATE (X11) example
#
# Structurally validated in CI; still review before use.
# Install (copy as ~/.config/systemd/user/pwr-tray.service):
#   mkdir -p ~/.config/pwr-tray ~/.config/systemd/user
#   cp pwr-tray-mate.service ~/.config/systemd/user/pwr-tray.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now pwr-tray.service

[Unit]
Description=pwr-tray (power/energy tray applet)
ConditionEnvironment=XDG_CURRENT_DESKTOP=MATE
PartOf=graphical-session.target
After=graphical-session.target
BindsTo=graphical-session.target
# Give up on a genuine crash loop instead of respawning forever.
StartLimitIntervalSec=60
StartLimitBurst=5
Requires=dbus.socket
After=dbus.socket

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
Environment=XDG_CURRENT_DESKTOP=MATE
Environment=XDG_SESSION_TYPE=x11
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStartPre=/bin/sleep 1
ExecStart=%h/.local/bin/pwr-tray --de mate-x11
Restart=always
RestartSec=5
# Exit codes 2 and 3 are permanent: 3 means another pwr-tray holds the lock,
# 2 means the applet could not be constructed (unknown desktop, missing
# resource, or a required command missing from PATH).  Restarting those only
# repeats the same failure every 5 seconds, so let the unit fail instead.
RestartPreventExitStatus=2 3
StandardOutput=append:%h/.config/pwr-tray/debug.log
StandardError=inherit

[Install]
WantedBy=graphical-session.target
